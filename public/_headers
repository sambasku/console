# Security headers untuk semua rute konsol admin (issue #19 H-01).
# Konsol bukan halaman publik: frame situs lain diblokir, crawler diblokir.
# media-src: native <audio> butuh blob: (preview rekam) + https: (CDN jsDelivr).
# Tanpa media-src, default-src 'self' memblokir player inline - user terpaksa
# buka link di tab baru. microphone=(self): MediaRecorder di form pelafalan.
# connect-src + upload.imagekit.io: direct upload bukti bayar Baleho / gambar
# kata (browser POST ke ImageKit, bukan lewat API worker).
# script-src 'wasm-unsafe-eval' + connect-src blob: / unpkg.com: player
# @lottiefiles/dotlottie-react memuat modul WASM dan pratinjau lokal .lottie.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' blob: https://api.sambasku.com https://cloudflare.sambasku.com https://sambasku-staging.iamutaki.com https://cdn.jsdelivr.net https://unpkg.com https://nominatim.openstreetmap.org https://tile.openstreetmap.org https://tiles.openfreemap.org https://upload.imagekit.io; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
